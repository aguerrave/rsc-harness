package ${package};

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;

import org.compiere.model.MOrder;
import org.compiere.process.DocAction;
import org.compiere.process.ProcessInfo;
import org.compiere.wf.MWorkflow;
import org.idempiere.test.AbstractTestCase;
import org.idempiere.test.DictionaryIDs;
import org.junit.jupiter.api.Test;

/**
 * Runs inside a live iDempiere (OSGi + GardenWorld database), not mocked.
 * Each test method gets a logged-in GardenWorld Admin context and its own
 * transaction (getTrxName()), rolled back after the method: pass it to every
 * model constructor, Query and DB call so nothing is left behind.
 */
public class ${testClassName} extends AbstractTestCase {

	@Test
	public void ${testMethodName}() {
		MOrder order = new MOrder(getCtx(), 0, getTrxName());
		order.setBPartner(org.compiere.model.MBPartner.get(getCtx(), DictionaryIDs.C_BPartner.JOE_BLOCK.id));
		order.setC_DocTypeTarget_ID(DictionaryIDs.C_DocType.STANDARD_ORDER.id);
		order.setIsSOTrx(true);
		order.saveEx();

		// Complete documents the way the UI does, then reload before asserting.
		ProcessInfo info = MWorkflow.runDocumentActionWorkflow(order, DocAction.ACTION_Complete);
		assertFalse(info.isError(), info.getSummary());
		order.load(getTrxName());
		assertEquals(DocAction.STATUS_Completed, order.getDocStatus(), "order should be completed");
	}
}
